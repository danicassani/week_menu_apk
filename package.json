{
  "name": "week-menu-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:households": "playwright test --config playwright.households.config.ts",
    "format": "prettier --write src tests scripts README.md public/manifest.webmanifest *.ts *.json index.html docs/setup.md docs/milestone-*.md docs/version-2/*.md docs/activity-sources.md .github/workflows/ci.yml",
    "format:check": "prettier --check src tests scripts README.md public/manifest.webmanifest *.ts *.json index.html docs/setup.md docs/milestone-*.md docs/version-2/*.md docs/activity-sources.md .github/workflows/ci.yml",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:release": "playwright test --config playwright.release.config.ts",
    "check:deployment": "node scripts/check-deployment.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@supabase/supabase-js": "^2.118.0",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
